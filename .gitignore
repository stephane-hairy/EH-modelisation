# Texte extrait des sources : fichier de travail, régénérable
sources/*.txt

# Données récupérées par script
donnees/brut/*
donnees/traite/*
!donnees/**/.gitkeep

# Exception : la série d'empreintes EXIOBASE. Régénérable
# (scripts/serie_exiobase.py) mais coûte 2 h de calcul et 7 Go de
# téléchargement. 8 Ko versionnés valent mieux.
!donnees/traite/empreinte_exiobase_france.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Sorties (régénérables par script)
sorties/
*.png
*.pdf
!sources/*.pdf

# Exceptions : les graphiques livrables. Régénérables par script, mais ce
# sont LES résultats : ils doivent être visibles sur GitHub sans rien
# exécuter.
!sorties/creation_monetaire_eh_france.png
!sorties/irnr_territorial_vs_empreinte.png

# Métadonnées de build
*.egg-info/
